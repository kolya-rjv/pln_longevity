# Copy this file to .env and fill in your values
OPENAI_API_KEY=sk-...

# Optional overrides
# PLN_MODEL=gpt-4o
# PLN_RUNTIME_AVAILABLE=false

# Optional: HTTP API (api.py)
# PLN_API_HOST=0.0.0.0
# PLN_API_PORT=8000
# PLN_API_KEY=some-shared-secret   # if set, requests need header: X-API-Key: <value>
# PLN_API_KEYS=key-for-agent-a,key-for-agent-b   # several, revocable one at a time
#   Both are UNSET by default and the service is then completely open, which is
#   what the Gradio UI and the local test suite expect. Setting either one also
#   locks the browser UI (it cannot send the header) — /health, /docs, /redoc
#   and /openapi.json stay open so a caller can still discover what it needs.
# PLN_RATE_LIMIT_PER_MINUTE=60   # per client address, 0 = off (the default)
#   A per-process courtesy limit, not a security control: behind a proxy every
#   caller shares the proxy's address. See pln_chat/core/rate_limit.py.

# Optional: the COMBINED server (app.py) — the launch API.md documents.
#   `python app.py` mounts the Gradio UI and the FastAPI app on ONE listener,
#   and it binds these, NOT the PLN_API_* pair above (those are read only by
#   `python api.py`, the API-only entry point). Setting PLN_API_PORT and then
#   launching app.py changes nothing, which is exactly the confusion this
#   block exists to prevent.
# PLN_SERVER_HOST=127.0.0.1
# PLN_SERVER_PORT=7860

# Optional: PLN execution. MeTTa runs in a forked process per query because
# hyperon holds the GIL for the whole of MeTTa.run(); see API.md.
# PLN_WORKER_POOL_SIZE=2          # concurrent query processes. 0 RUNS INLINE,
#   which also turns OFF the deadline and the admission limit — neither is
#   enforceable in-process. /health reports timeout_enforced=false when it is.
# PLN_QUERY_TIMEOUT_SECONDS=60    # per-request budget; 0 disables
# PLN_MAX_INFLIGHT_QUERIES=0      # 0 derives 4x PLN_WORKER_POOL_SIZE

# Optional: request caps
# PLN_MAX_RANK_COMPOUNDS=60          # a ranking's compound pool, at every door
# PLN_MAX_METTA_SORT_COMPOUNDS=10    # the O(n^2) reference strategy's own cap
# PLN_MAX_ONTOLOGY_FILES=64
# PLN_MAX_PROMPT_TOKENS=200000       # must stay well ABOVE the ~75,250-token
#   default prompt, or every /query is refused with 413 before the LLM is called
# PLN_PROMPT_FILE_MAX_BYTES=25000    # over this, a file becomes a schema card

# Optional: ontology writes (POST /ontology/apply and the UI's Apply button)
# PLN_ALLOW_CURATED_WRITES=0   # 1 lets a caller append to a CURATED .metta file
#   — the rules, the evidence tiers and the calibration constants the service
#   reasons from. Off, writes go to pln_chat/ontology/metta_files/ instead.
# PLN_MAX_APPLY_BYTES=32000

# Optional: CORS
# PLN_CORS_ORIGINS=https://example.com,https://other.example

# Optional: the last few, for completeness — config.py reads 25 variables and
# this file now documents all of them.
# OPENAI_TIMEOUT_SECONDS=30
# OPENAI_MAX_RETRIES=2
# PLN_CHARS_PER_TOKEN=4            # the estimator behind prompt_tokens_estimate
# PLN_MAX_KB_FILE_BYTES=60000      # a .metta file over this is NOT loaded into
#   the runtime space (hyperon aborts on large ones), so /ontology/apply refuses
#   an append that would cross it rather than silently un-loading the layer
# PLN_MAX_RANK_ROWS=120            # source rows echoed per ranking; 0 = none
