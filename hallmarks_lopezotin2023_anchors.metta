;; ------------------------------------------------------------
(HallmarkComponent MisfoldedProteins LossOfProteostasis)
(HallmarkComponent ProteinAggregates LossOfProteostasis)
(HallmarkComponent ProteasomeActivity LossOfProteostasis)
(HallmarkComponent UnfoldedProteinResponse LossOfProteostasis)
(HallmarkComponent EndoplasmicReticulumStress LossOfProteostasis)
(HallmarkComponent ChaperoneMediatedAutophagy LossOfProteostasis)
(HallmarkComponent LAMP2A LossOfProteostasis)
(HallmarkComponent HSC70 LossOfProteostasis)

;; ------------------------------------------------------------
;; Disabled macroautophagy
;; ------------------------------------------------------------
(HallmarkComponent AutophagicFlux DisabledMacroautophagy)
(HallmarkComponent Macroautophagy DisabledMacroautophagy)
(HallmarkComponent Mitophagy DisabledMacroautophagy)
(HallmarkComponent ATG5 DisabledMacroautophagy)
(HallmarkComponent ATG7 DisabledMacroautophagy)
(HallmarkComponent BECN1 DisabledMacroautophagy)
(HallmarkComponent EP300 DisabledMacroautophagy)
(HallmarkComponent EIF5A DisabledMacroautophagy)
(HallmarkComponent TFEB DisabledMacroautophagy)

;; ------------------------------------------------------------
;; Deregulated nutrient-sensing
;; ------------------------------------------------------------
(HallmarkComponent NutrientSensingNetwork DeregulatedNutrientSensing)
(HallmarkComponent InsulinIGFSignaling DeregulatedNutrientSensing)
(HallmarkComponent IGF1 DeregulatedNutrientSensing)
(HallmarkComponent MTORC1 DeregulatedNutrientSensing)
(HallmarkComponent AMPK DeregulatedNutrientSensing)
(HallmarkComponent SIRT1 DeregulatedNutrientSensing)
(HallmarkComponent SIRT3 DeregulatedNutrientSensing)

;; ------------------------------------------------------------
;; Mitochondrial dysfunction
;; ------------------------------------------------------------
(HallmarkComponent MitochondrialRespiration MitochondrialDysfunction)
(HallmarkComponent MitochondrialMetabolism MitochondrialDysfunction)
(HallmarkComponent mtDNA MitochondrialDysfunction)
(HallmarkComponent ROS MitochondrialDysfunction)
(HallmarkComponent Mitophagy MitochondrialDysfunction)

;; ------------------------------------------------------------
;; Cellular senescence
;; ------------------------------------------------------------
(HallmarkComponent SenescentCells CellularSenescence)
(HallmarkComponent SASP CellularSenescence)
(HallmarkComponent CDKN2A_P16 CellularSenescence)
(HallmarkComponent CDKN1A_P21 CellularSenescence)

;; ------------------------------------------------------------
