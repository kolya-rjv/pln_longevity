;; hallmarks_lopezotin2023_anchors.metta
;; Curated conceptual anchors directly discussed in Lopez-Otin et al. (2023).
;;
;; These are NOT statistical correlations and do NOT carry invented STVs.
;; Use HallmarkComponent for ontology navigation and source-backed retrieval.

;; ------------------------------------------------------------
;; Genomic instability
;; ------------------------------------------------------------
(HallmarkComponent NuclearDNA GenomicInstability)
(HallmarkComponent mtDNA GenomicInstability)
(HallmarkComponent DNARepairEfficiency GenomicInstability)
(HallmarkComponent NuclearArchitecture GenomicInstability)
(HallmarkComponent SomaticMutationBurden GenomicInstability)
(HallmarkComponent SIRT6 GenomicInstability)
(HallmarkComponent OGG1 GenomicInstability)

;; ------------------------------------------------------------
;; Telomere attrition
;; ------------------------------------------------------------
(HallmarkComponent TelomereShortening TelomereAttrition)
(HallmarkComponent TelomeraseActivity TelomereAttrition)
(HallmarkComponent TelomereUncapping TelomereAttrition)
(HallmarkComponent Shelterins TelomereAttrition)
(HallmarkComponent TERT TelomereAttrition)

;; ------------------------------------------------------------
;; Epigenetic alterations
;; ------------------------------------------------------------
(HallmarkComponent DNAMethylation EpigeneticAlterations)
(HallmarkComponent HistoneModification EpigeneticAlterations)
(HallmarkComponent ChromatinRemodeling EpigeneticAlterations)
(HallmarkComponent NonCodingRNA EpigeneticAlterations)
(HallmarkComponent RetrotransposonDerepression EpigeneticAlterations)
(HallmarkComponent EpigeneticClock EpigeneticAlterations)
(HallmarkComponent SIRT1 EpigeneticAlterations)
(HallmarkComponent SIRT3 EpigeneticAlterations)
(HallmarkComponent SIRT6 EpigeneticAlterations)
(HallmarkComponent SIRT7 EpigeneticAlterations)
(HallmarkComponent KAT7 EpigeneticAlterations)

;; ------------------------------------------------------------
